## La commande complète de composition (le pipeline entier)

```bash
D=/Users/zenray/Downloads/tmp-shorts-vestibule-louisiana-bayou
S=chemin/vers/scripts   # ou "$D/scripts"
B="$D/tests/backgrounds"
O="$D/tests/mov"

# 1. fond animé en fichier intermédiaire (voir ci-dessus) -> bg_noise_v4.mov

# 2. composition principale : vidéo source + titre/sous-titres + fond + audio
python3 $S/render_short.py | ffmpeg -y -v error \
  -i "$D/raw/screen/turntable-ecran-30s.mov" \
  -f rawvideo -pix_fmt rgba -s 1080x1920 -r 30 -i pipe:0 \
  -i "$D/audio/cuts/every-dawn-and-dusk-30s.mp3" \
  -i "$B/bg_noise_v4.mov" \
  -filter_complex "
    [0:v]fps=30,split=2[bgsrc][fgsrc];
    [bgsrc]scale=1080:1920:force_original_aspect_ratio=increase,crop=1080:1920,boxblur=40:5,eq=brightness=-0.15,format=gbrp[bgblur];
    [3:v]format=gbrp[grad];
    [grad][bgblur]blend=all_mode=screen,format=yuv420p[bgscreen];
    [bgscreen]gblur=sigma=14:steps=2,eq=brightness=-0.16:saturation=0.82[bggrad];
    [fgsrc]scale=1080:-2[fg];
    [bggrad][fg]overlay=(W-w)/2:(H-h)/2[base];
    [base][1:v]overlay=0:0:format=auto[vout]
  " \
  -map "[vout]" -map 2:a \
  -c:v libx264 -preset slow -crf 18 -pix_fmt yuv420p -movflags +faststart \
  -c:a aac -b:a 320k -t 30 \
  "$O/TEST-base.mov"

# 3. merge du flash NEW au tout début, plein cadre, sans crop
ffmpeg -y -v error -i "$D/assets/overlays/impact-new-flash-030s.mov" -i "$O/TEST-base.mov" \
  -filter_complex "[1:v][0:v]overlay=0:0:eof_action=pass:format=auto[vout]" \
  -map "[vout]" -map 1:a \
  -c:v libx264 -preset slow -crf 18 -pix_fmt yuv420p -movflags +faststart \
  -c:a copy \
  "$O/OUTPUT-FINAL.mov"
```

